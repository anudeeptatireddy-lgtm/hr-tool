GEMINI_API_KEY=
# Older Flash models 404 for new keys; the v1 endpoint is used.
GEMINI_MODEL=gemini-3.6-flash
RESEND_API_KEY=
# Until you verify a domain in Resend, the test sender can only deliver to your own signup email.
RESEND_FROM=onboarding@resend.dev
# DEMO MODE: every candidate email is redirected here instead of the candidate's real address.
DEMO_MODE=true
DEMO_RECIPIENT=your-own-email@example.com
ARJUN_EMAIL=your-own-email@example.com
